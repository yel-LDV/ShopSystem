# ==============================================
# Sistema de Inventario y Pedidos
# Copia este archivo a .env y configura tus valores
# ==============================================

# ── Base de Datos (MariaDB) ──────────────────
# Servidor externo de MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_NAME=market
DB_USER=root
DB_PASS=
# Contrasena root de MariaDB (para Docker)
DB_ROOT_PASS=

# ── Seguridad ────────────────────────────────
# Clave JWT: minimo 32 caracteres. Genera una con:
#   openssl rand -base64 32
JWT_SECRET=cambia-esta-clave-jwt-32-caracteres-minimo

# ── Backups ──────────────────────────────────
# Directorio donde se guardan los backups encriptados
BACKUP_DIR=./backups
# Clave AES-256: exactamente 32 caracteres
BACKUP_KEY=cambia-esta-clave-aes-32-caracteres

# ── Correo Electronico (notificaciones) ──────
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu-correo@gmail.com
MAIL_PASS=tu-contrasena-de-aplicacion

# ── Reorden Automatico ───────────────────────
# Cron: cada hora
REORDER_CRON=0 0 * * * *

# ── Frontend ─────────────────────────────────
# URL del backend (para desarrollo local)
VITE_API_URL=http://localhost:8080
# URL del WebSocket
VITE_WS_URL=http://localhost:8080/ws
